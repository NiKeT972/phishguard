# PhishGuard Environment Variables
# Copy this file to .env and add your API keys
# The app works without API keys using AI model + regex detection

# Optional: Google Safe Browsing API (free)
# Get key at: https://console.cloud.google.com -> Enable "Safe Browsing API"
GOOGLE_SAFE_BROWSING_KEY=your_key_here

# Optional: VirusTotal API (free, 4 req/min)
# Get key at: https://www.virustotal.com -> Profile -> API Key
VIRUSTOTAL_KEY=your_key_here
